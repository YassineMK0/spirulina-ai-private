
echo "[pre-commit] checking staged Python files for syntax errors..."
# NUL-delimited (-z / -0) end to end: staged paths can contain spaces (e.g.
# "mqtt simulator/sensors.py"), and piping straight into xargs -- rather than
# capturing into a shell variable first -- matters here too, since bash's
# $(...) command substitution silently drops NUL bytes and would otherwise
# glue every path back together into one unopenable string.
git diff --cached --name-only --diff-filter=ACM -z -- '*.py' | xargs -0 -r .venv313/Scripts/python.exe -m py_compile
if [ $? -ne 0 ]; then
  echo "[pre-commit] Python syntax check FAILED -- fix the file(s) above before committing."
  exit 1
fi

STAGED_FRONTEND=$(git diff --cached --name-only --diff-filter=ACM -- 'spirulina-ui/*.js' 'spirulina-ui/*.jsx')
if [ -n "$STAGED_FRONTEND" ]; then
  echo "[pre-commit] running frontend tests (jest)..."
  (cd spirulina-ui && npm test -- --silent) || {
    echo "[pre-commit] jest FAILED -- fix failing frontend tests before committing."
    exit 1
  }
fi

echo "[pre-commit] OK"
